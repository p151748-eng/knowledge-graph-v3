# ================================================================
# KG-Agent System v2 环境变量配置
# ================================================================

# ── 数据库配置 ──────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/konw

# ── LLM 提供商配置 ──────────────────────────────────────────────
# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=text-embedding-v3

# Anthropic（Claude 系列）
ANTHROPIC_API_KEY=your-anthropic-key

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 阿里通义千问（默认）
QWEN_API_KEY=your-qwen-key

# ── 默认 LLM 设置 ────────────────────────────────────────────────
# 默认使用的 LLM 提供商（openai/anthropic/deepseek/dashscope）
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7

# ── 向量嵌入配置 ─────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-v3

# ── 联网搜索配置 ─────────────────────────────────────────────────
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_AUTO_SAVE=true
BOCHA_SEARCH_ENABLED=true
BOCHA_SEARCH_URL=https://api.bocha.cn/v1/web-search
BOCHA_API_KEY=your-bocha-api-key
BOCHA_SEARCH_SUMMARY=true
BOCHA_SEARCH_FRESHNESS=noLimit

# ── 服务配置 ─────────────────────────────────────────────────────
PORT=8001
HOST=0.0.0.0
DEBUG=true

# ── JWT 配置 ─────────────────────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Chroma 向量库配置 ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data

# ── LangSmith Tracing ─────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-key
